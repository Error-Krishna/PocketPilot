# ==================================================
# Environment Variables / Secrets
# ==================================================
.env
.env.*
!.env.example

# Firebase server-side service account — never commit, contains a
# private key. NOTE: google-services.json is intentionally NOT listed
# here — that file only contains client-side Firebase config (API keys
# meant to ship inside the app bundle), not a secret, and must stay
# committed or Android builds break for anyone else who clones this repo.
firebase-service-account.json

